# Copy file nay thanh .env roi dien gia tri that.
# .env da nam trong .gitignore nen se khong bi day len GitHub.

# RPC URL cua mang Sepolia (lay tu Alchemy hoac Infura, goi mien phi)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Private key cua VI TEST dung de deploy (chi dung vi chua ETH Sepolia, khong dung vi that)
PRIVATE_KEY=0xyour_test_wallet_private_key

# API key Etherscan de verify contract
ETHERSCAN_API_KEY=your_etherscan_api_key
